generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────

enum ListingCategory {
  Cameras
  PowerTools
  Bikes
  CampingGear
}

enum ListingStatus {
  active
  paused
  pending
  rejected
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PickupMethod {
  pickup
  delivery
}

enum DisputeStatus {
  flagged
  under_review
  resolved
}

enum DepositStatus {
  held
  released
  claimed
  partially_claimed
}

enum HandoffStage {
  pickup
  // `returned`, not `return` — `return` is a JS/TS keyword and the generated
  // client exposes enum values as bare property names.
  returned
}

enum ReviewDirection {
  renter_to_owner
  owner_to_renter
}

enum NotificationType {
  booking_requested
  booking_confirmed
  booking_cancelled
  message_received
  dispute_filed
  dispute_resolved
  deposit_released
}

enum CancellationPolicy {
  flexible
  moderate
  strict
}

enum CancelledBy {
  renter
  owner
}

// ── Core entities ─────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  initials     String
  // Every user can rent. isOwner flips on once they create their first
  // listing — this replaces a renter/owner enum so one account can do both,
  // matching the "same account, role-based" decision from the design phase.
  isOwner      Boolean   @default(false)
  isSuspended  Boolean   @default(false)
  memberSince  DateTime  @default(now())
  responseTime String?
  deletedAt    DateTime?

  listings               Listing[]
  bookings               Booking[]       @relation("RenterBookings")
  messages               Message[]
  messageThreadsAsRenter MessageThread[] @relation("RenterThreads")
  reviewsAuthored        Review[]        @relation("ReviewsAuthored")
  reviewsReceived        Review[]        @relation("ReviewsReceived")
  notifications          Notification[]
  handoffPhotos          HandoffPhoto[]

  @@map("users")
}

model Listing {
  id                 String             @id @default(uuid())
  title              String
  category           ListingCategory
  // ISO 3166-1 alpha-2 country code, validated at the DTO layer with
  // class-validator's @IsISO31661Alpha2(). Drives the listing's charge/
  // display currency via CURRENCY_BY_COUNTRY (src/common/country-currency.ts)
  // — deliberately a plain string, not a Prisma enum: ~250 countries would
  // make that enum a migration magnet every time ISO revises the list.
  country            String             @default("ZA") @db.Char(2)
  pricePerDay        Decimal            @db.Decimal(10, 2)
  // What the owner asks renters to put up as a security deposit. 0 (the
  // default) means this listing takes no deposit and booking creation
  // places no second hold.
  depositAmount      Decimal            @default(0) @db.Decimal(10, 2)
  // Renter-facing refund tiers on cancellation. Owner picks this at
  // create/edit time; a past booking snapshots the rate it was cancelled
  // under (Booking.refundAmount) so a later policy change can't rewrite it.
  cancellationPolicy CancellationPolicy @default(moderate)
  description        String             @db.Text
  // ponytail: images stored as data URLs, no object storage. Fine for
  // mock/dev scale; move to S3/R2 + store URLs here if photo count/size
  // grows.
  images             String[]           @default([])
  status             ListingStatus      @default(pending)
  createdAt          DateTime           @default(now())
  deletedAt          DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  bookings  Booking[]
  threads   MessageThread[]
  blackouts Blackout[]

  // Note: mock data's unavailableDaysOfMonth is gone. Availability is
  // derived from confirmed Bookings (auto, can't drift) plus owner-created
  // Blackout rows (explicit, for personal use/travel/repairs) — never a
  // stored day list that could drift out of sync on its own.

  @@map("listings")
}

model Booking {
  id            String        @id @default(uuid())
  requestNumber String        @unique @default(cuid())
  status        BookingStatus @default(pending)
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  pickupMethod  PickupMethod
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  // Snapshot of the listing's charge currency at booking time (see
  // Listing.country), same reasoning as pricePerDayAtBooking below.
  currency String @default("ZAR")

  depositStatus DepositStatus?

  // Snapshot, same reasoning as pricePerDayAtBooking: an owner raising a
  // listing's deposit must not retroactively change what a past booking
  // held. Deliberately NOT part of subtotal/total.
  depositAmount Decimal @default(0) @db.Decimal(10, 2)

  // Cancellation record. Null until the booking is cancelled. refundAmount
  // is a snapshot of what was actually released/refunded — same reasoning
  // as pricePerDayAtBooking, so a later change to the listing's
  // cancellationPolicy can't rewrite a past cancellation's terms.
  cancelledAt        DateTime?
  cancelledBy        CancelledBy?
  cancellationReason String?
  refundAmount       Decimal?     @db.Decimal(10, 2)

  // Pricing snapshot at time of booking — stored, not recomputed, since
  // Listing.pricePerDay can change later and a past booking's receipt
  // shouldn't retroactively change with it.
  pricePerDayAtBooking Decimal @db.Decimal(10, 2)
  nights               Int
  subtotal             Decimal @db.Decimal(10, 2)
  serviceFee           Decimal @db.Decimal(10, 2)
  tax                  Decimal @db.Decimal(10, 2)
  total                Decimal @db.Decimal(10, 2)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  renterId String
  renter   User   @relation("RenterBookings", fields: [renterId], references: [id])

  dispute       Dispute?
  reviews       Review[]
  handoffPhotos HandoffPhoto[]

  // "No overlapping date ranges per listing" is enforced in the DB by the
  // bookings_no_overlapping_confirmed EXCLUDE constraint (btree_gist, raw
  // SQL — Prisma can't express EXCLUDE, so it's unmanaged here) on
  // (listingId, daterange(startDate, endDate)) WHERE status = 'confirmed'.
  // BookingsService.assertNoActiveOverlap / blockingBooking() in
  // booking-availability.util.ts do the same check at the application level
  // for a friendlier error; the DB constraint is the backstop for the race
  // between two concurrent requests.

  @@index([listingId, status])
  @@map("bookings")
}

model Blackout {
  id        String   @id @default(uuid())
  // Half-open, same convention as Booking: startDate inclusive, endDate
  // exclusive. Every overlap check in this codebase is written for that.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
  @@map("blackouts")
}

model MessageThread {
  id              String   @id @default(uuid())
  unreadForRenter Boolean  @default(false)
  unreadForOwner  Boolean  @default(false)
  createdAt       DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  renterId String
  renter   User   @relation("RenterThreads", fields: [renterId], references: [id])
  // Owner is intentionally not a separate FK here — it's always
  // listing.owner. Storing it again would let it silently drift if a
  // listing ever changed hands.

  messages Message[]

  @@map("message_threads")
}

model Message {
  id     String   @id @default(uuid())
  text   String   @db.Text
  sentAt DateTime @default(now())

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])
  // Whether the sender was acting as "renter" or "owner" for this message
  // is derived by comparing senderId to thread.renterId vs listing.ownerId
  // — not stored, since it's fully computable and storing it risks drift.

  @@map("messages")
}

model Dispute {
  id     String        @id @default(uuid())
  status DisputeStatus @default(flagged)
  detail String        @db.Text

  // Null = a plain free-text dispute, exactly as before this feature.
  // Non-null = a damage claim against the booking's deposit. Bounded by
  // booking.depositAmount at the service layer (no DB check constraint,
  // matching the Review.rating precedent).
  claimAmount    Decimal? @db.Decimal(10, 2)
  // What an admin actually awarded: 0 <= resolvedAmount <= claimAmount.
  // Drives the partial capture at resolution time.
  resolvedAmount Decimal? @db.Decimal(10, 2)

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  // Replaces the old free-text "parties" field — renter, owner, and
  // listing are all reachable through booking.renter and
  // booking.listing.owner instead of being duplicated as text.

  @@map("disputes")
}

model Review {
  id        String          @id @default(uuid())
  // 1-5, validated at the DTO layer (@IsInt/@Min(1)/@Max(5)) — deliberately
  // no DB check constraint, matching the design doc.
  rating    Int
  comment   String?         @db.Text
  // Stored rather than inferred from authorId vs booking.renterId so that
  // "one review per side per booking" is a DB unique constraint, and so
  // "reviews about this listing/owner" is a plain filter, not a per-row compare.
  direction ReviewDirection
  createdAt DateTime        @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  authorId String
  author   User   @relation("ReviewsAuthored", fields: [authorId], references: [id])

  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, direction])
  @@map("reviews")
}

model HandoffPhoto {
  id    String       @id @default(uuid())
  stage HandoffStage
  // A URL the client uploaded somewhere else. This API stores no bytes and
  // has no upload path — same convention as Listing.images, same upgrade
  // path (object storage) when mock/dev scale stops holding.
  url   String
  note  String?      @db.Text

  // Server-set, never client-supplied. A timestamp the photographer chooses
  // is not evidence, and "timestamped" is the entire point of this table.
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  // Renter-or-owner is derived by comparing this to booking.renterId, the
  // same way Message derives it from senderId — storing it would buy
  // nothing here (no unique constraint depends on it) and could drift.
  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  @@index([bookingId, createdAt])
  @@map("handoff_photos")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String? // relative frontend path, e.g. "/bookings/:id"
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

// ── Staff / admin (separate auth domain) ──────────────

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  initials     String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
