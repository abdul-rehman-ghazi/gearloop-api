DATABASE_URL="postgresql://user:password@localhost:5432/rental_marketplace?schema=public"

PORT=3000

# Must be a distinct secret from JWT_ADMIN_SECRET — User and AdminUser tokens
# must never be interchangeable.
JWT_USER_SECRET="replace-with-a-long-random-string"
JWT_USER_EXPIRES_IN="1d"

# Must be a distinct secret from JWT_USER_SECRET.
JWT_ADMIN_SECRET="replace-with-a-different-long-random-string"
JWT_ADMIN_EXPIRES_IN="1d"

BCRYPT_SALT_ROUNDS=10
